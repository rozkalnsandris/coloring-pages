{
  "name": "coloring-pages-stats-v1",
  "main": "cloudflare/stats-worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coloring-pages-stats-v1",
      "database_id": "f8ac8f1d-a230-4bc4-af13-557c1b91b273"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1152026106",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "CF_ANALYTICS_API_TOKEN",
      "VISITOR_HMAC_KEY"
    ]
  }
}
