  "mutation": {
    "private_sources_immutable": true,
    "existing_media_immutable": true,
    "new_print_strategy": "full-sha256-content-addressed-filename",
    "catalog_preserve_order": true,
    "allowed_catalog_changes": [
      "single-page:print",
      "multi-page:pages[index-1].print",
      "multi-page-page1:top-level-print"
    ],
    "thumb_and_preview_unchanged": true,
    "delete_allowed": false,
    "overwrite_allowed": false
  },
  "workflow": {
    "plan": "generate all 16 A4 print outputs in temporary storage, validate them, bind exact output SHA-256/size/URL and target current-print baselines, emit one canonical plan SHA-256, no production write",
    "apply": "under shared lock, recompute exact plan, require owner-bound plan SHA-256, write all new content-addressed print files exclusively, then atomically switch only target catalog print fields",
    "unrelated_new_catalog_entries": "preserve"
  },
  "failure": {
    "retry": false,
    "rollback": false,
    "cleanup": false,
    "alternate_mutation_path": false,
    "after_first_persistent_write": "STOP"
  }
