{
  "schema": "rozkalns.github-first-rdc-fallback.consumer.v1",
  "status": "SOURCE_ADOPTION_ON_MERGE",
  "repository": "rozkalnsandris/coloring-pages",
  "upstream": {
    "repository": "rozkalnsandris/ops-workflows",
    "revision": "4e89b75d7f496dfb43fd9c1eb10a995fad53fdd8",
    "document": "docs/GITHUB_FIRST_RDC_FALLBACK_V1.md",
    "policy": "policy/github-first-rdc-fallback-v1.json"
  },
  "selection": {
    "per_step": true,
    "github_equivalent_mandatory": true,
    "github_actions_when_equivalent": true,
    "rdc_for_convenience_allowed": false,
    "order": [
      "GITHUB_CONNECTED_TOOLS",
      "GITHUB_HOSTED_CI_WHEN_APPLICABLE",
      "MINIMAL_AUTHORIZED_RDC_IF_GITHUB_INCAPABLE",
      "STOP"
    ]
  },
  "rdc_exception": {
    "host_local_need_required": true,
    "github_gap_proven": true,
    "github_actions_equivalence_ruled_out": true,
    "minimum_operation": true,
    "existing_exact_authorization": true,
    "public_safe_evidence": true,
    "return_to_github": true,
    "evidence_fields": [
      "STEP",
      "REPOSITORY_AND_TARGET",
      "GITHUB_CAPABILITY_CHECKED",
      "PRECISE_CAPABILITY_GAP",
      "GITHUB_CI_NOT_EQUIVALENT_REASON",
      "MINIMAL_RDC_OPERATION",
      "EXISTING_AUTHORIZATION",
      "GITHUB_RETURN_EVIDENCE"
    ]
  },
  "fail_closed": {
    "github_403_429_denial_never_rdc": true,
    "github_error_timeout_never_rdc": true,
    "uncertain_github_write_never_rdc": true,
    "missing_owner_authority_stops": true,
    "no_auto_retry_rollback_cleanup": true,
    "no_implicit_merge_live_permission_secret_settings_authority": true
  },
  "local_boundaries": {
    "lightweight_work_cycle_preserved": true,
    "no_extra_bootstrap_manifest": true,
    "existing_source_media_separation": true,
    "media_not_stored_in_github": true,
    "explicit_owner_merge_required": true,
    "eligible_app_merge_auto_live_contract_unchanged": true,
    "publish_requires_fresh_exact_owner_approval": true,
    "full_issues_source_only": true,
    "no_queue_or_github_only_activation": true,
    "production_and_cloudflare_strict": true
  },
  "deploy_trigger": {
    "workflow": ".github/workflows/simple-deploy.yml",
    "approved_paths": [
      "Dockerfile",
      "tools/coloring-pages-import",
      "deploy/nginx.conf",
      "index.html",
      "detail.html",
      "print.html",
      "css/**",
      "js/**",
      "assets/**"
    ],
    "governance_only_activates_deploy": false
  },
  "cases": [
    {
      "name": "repo-source-file-change",
      "github": true,
      "ci": false,
      "host": false,
      "error": false,
      "authority": true,
      "expected": "GITHUB"
    },
    {
      "name": "github-actions-source-check",
      "github": false,
      "ci": true,
      "host": false,
      "error": false,
      "authority": true,
      "expected": "GITHUB_ACTIONS"
    },
    {
      "name": "authorized-rpi5-media-store-observation",
      "github": false,
      "ci": false,
      "host": true,
      "error": false,
      "authority": true,
      "expected": "RDC_EXCEPTION"
    },
    {
      "name": "rpi5-publish-no-specific-authorization",
      "github": false,
      "ci": false,
      "host": true,
      "error": false,
      "authority": false,
      "expected": "STOP"
    },
    {
      "name": "github-rate-limit-or-denied",
      "github": false,
      "ci": false,
      "host": false,
      "error": true,
      "authority": true,
      "expected": "STOP"
    },
    {
      "name": "uncertain-github-write-no-rdc-retry",
      "github": false,
      "ci": false,
      "host": true,
      "error": true,
      "authority": true,
      "expected": "STOP"
    },
    {
      "name": "github-inability-with-no-host-purpose",
      "github": false,
      "ci": false,
      "host": false,
      "error": false,
      "authority": true,
      "expected": "STOP"
    },
    {
      "name": "rdc-convenience-when-github-supports",
      "github": true,
      "ci": false,
      "host": true,
      "error": false,
      "authority": true,
      "expected": "GITHUB"
    }
  ]
}
