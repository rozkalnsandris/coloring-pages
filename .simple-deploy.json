{
  "schema": "rozkalns.simple-deploy.consumer.v1",
  "repository": "rozkalnsandris/coloring-pages",
  "image": "ghcr.io/rozkalnsandris/coloring-pages",
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile",
    "architecture": "linux/arm64"
  },
  "target": {
    "alias": "coloring-pages-public-rpi5",
    "runtime_class": "rpi5-compose"
  },
  "compose": {
    "project": "coloring-pages-public",
    "file": "deploy/docker-compose.simple.yml",
    "service": "coloring-pages"
  },
  "health": {
    "liveness_path": "/health",
    "readiness": {
      "state": "required",
      "path": "/ready"
    }
  },
  "persistence": {
    "volumes": [
      "/srv/coloring-pages-content/public:/var/lib/coloring-pages/public:ro"
    ]
  },
  "registry": {
    "pull_profile": "public-anonymous-pull"
  },
  "forbidden_operations": [
    "database-schema-data-mutation",
    "destructive-recovery",
    "secrets-credentials-permissions",
    "cloudflare-dns-network",
    "private-provider-activation",
    "unrelated-host-control"
  ]
}
