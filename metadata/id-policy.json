{
  "schema": "rozkalns.coloring-pages.id-policy.v2",
  "new_publication": {
    "format": "NNNNNNN",
    "digits": 7,
    "pattern": "^[0-9]{7}$",
    "allocation": "random-with-collision-check",
    "semantic_components": false,
    "example": "0427183"
  },
  "allocation_source": {
    "canonical_state": "live-catalog",
    "catalog_path": "/srv/coloring-pages-content/public/catalog.json",
    "candidate_must_be_absent_before_first_mutation": true,
    "collision_before_first_mutation": "generate-another-random-candidate",
    "current_batch_candidates_must_be_unique": true,
    "exhaustion_behavior": "stop"
  },
  "legacy_ids": {
    "accepted": true,
    "immutable": true,
    "rename_existing": false,
    "count_toward_allocation": false
  }
}
