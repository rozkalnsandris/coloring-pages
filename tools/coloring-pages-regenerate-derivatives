#!/usr/bin/env python3
"""Regenerate public derivatives for the exact frozen farben-zuordnen-001 baseline."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import io
import json
import os
import sys
from pathlib import Path
from typing import Any

from PIL import Image

CONTENT_ROOT = Path("/srv/coloring-pages-content")
CONTRACT_SCHEMA = "rozkalns.coloring-pages.existing-derivative-regeneration.v1"
CONTAINER_CONTRACT = Path(
    "/usr/local/share/coloring-pages/existing-derivative-regeneration-v1.json"
)
CONTAINER_IMPORTER = Path("/usr/local/bin/coloring-pages-import")
FILES = ("thumb.webp", "preview.webp", "print.png")


class RegenerationError(RuntimeError):
    """Fail-closed derivative regeneration error."""


def fail(message: str) -> None:
    raise RegenerationError(message)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def contract_path() -> Path:
    if CONTAINER_CONTRACT.is_file():
        return CONTAINER_CONTRACT
    return Path(__file__).resolve().parents[1] / "deploy/existing-derivative-regeneration-v1.json"


def importer_path() -> Path:
    if CONTAINER_IMPORTER.is_file():
        return CONTAINER_IMPORTER
    return Path(__file__).resolve().parents[1] / "tools/coloring-pages-import"


def load_importer():
    path = importer_path()
    loader = importlib.machinery.SourceFileLoader("coloring_pages_import_regen", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        fail("importer module cannot be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def load_contract() -> dict[str, Any]:
    try:
        raw = json.loads(contract_path().read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise RegenerationError("regeneration contract is unavailable or invalid") from exc
    if not isinstance(raw, dict) or raw.get("schema") != CONTRACT_SCHEMA:
        fail("regeneration contract schema mismatch")
    return raw


def image_has_color(image: Image.Image) -> bool:
    for red, green, blue, alpha in image.convert("RGBA").getdata():
        if alpha and (red != green or green != blue):
            return True
    return False


def catalog_entry(content_root: Path, page_id: str) -> dict[str, Any]:
    try:
        raw = json.loads(
            (content_root / "public/catalog.json").read_text(encoding="utf-8")
        )
    except (OSError, json.JSONDecodeError) as exc:
        raise RegenerationError("catalog is unavailable or invalid") from exc
    if not isinstance(raw, list):
        fail("catalog must be a JSON array")
    matches = [
        item for item in raw
        if isinstance(item, dict) and item.get("id") == page_id
    ]
    if len(matches) != 1:
        fail("catalog page identity is missing or ambiguous")
    return matches[0]


def validate_contract_shape(contract: dict[str, Any]) -> None:
    page = contract.get("page")
    mutation = contract.get("mutation")
    runtime = contract.get("runtime")
    if contract.get("issue") != 71 or not isinstance(page, dict):
        fail("contract issue/page mismatch")
    if page.get("id") != "farben-zuordnen-001":
        fail("contract page id mismatch")
    if not isinstance(page.get("source_size_bytes"), int) or page["source_size_bytes"] <= 0:
        fail("contract source size is invalid")
    source_sha = page.get("source_sha256")
    if not isinstance(source_sha, str) or len(source_sha) != 64:
        fail("contract source sha256 is invalid")
    if set(page.get("current_derivatives", {})) != set(FILES):
        fail("contract derivative baseline mismatch")
    if not isinstance(page.get("catalog_entry"), dict):
        fail("contract catalog entry is invalid")
    if runtime != {
        "content_root": "/srv/coloring-pages-content",
        "shared_lock": "state/drive-ingest/.lock",
        "regenerator_entrypoint": "/usr/local/bin/coloring-pages-regenerate-derivatives",
    }:
        fail("contract runtime identity mismatch")
    expected_targets = [
        f"public/media/{page['id']}/{name}" for name in FILES
    ]
    if mutation.get("allowed_targets") != expected_targets:
        fail("contract mutation targets mismatch")
    if mutation.get("replace_order") != list(FILES):
        fail("contract replacement order mismatch")
    if mutation.get("forbidden_targets") != [
        f"originals/{page['id']}/source.png",
        "public/catalog.json",
    ]:
        fail("contract forbidden targets mismatch")


def preflight(content_root: Path, contract: dict[str, Any], importer) -> dict[str, Any]:
    validate_contract_shape(contract)
    page = contract["page"]
    page_id = page["id"]
    source = content_root / page["source_relative_path"]
    media = content_root / "public/media" / page_id
    lock = content_root / contract["runtime"]["shared_lock"]
    catalog_path = content_root / "public/catalog.json"

    if not content_root.is_dir() or not media.is_dir() or not lock.is_file():
        fail("required content layout is missing")
    if set(path.name for path in media.iterdir()) != set(FILES):
        fail("public media directory contains unexpected files")
    if not source.is_file():
        fail("private source is missing")
    if source.stat().st_size != page["source_size_bytes"]:
        fail("private source size drifted")
    if sha256_file(source) != page["source_sha256"]:
        fail("private source sha256 drifted")
    if catalog_entry(content_root, page_id) != page["catalog_entry"]:
        fail("catalog metadata drifted")

    for name in FILES:
        path = media / name
        baseline = page["current_derivatives"][name]
        if not path.is_file():
            fail(f"current derivative is missing: {name}")
        if path.stat().st_size != baseline["size_bytes"]:
            fail(f"current derivative size drifted: {name}")
        if sha256_file(path) != baseline["sha256"]:
            fail(f"current derivative sha256 drifted: {name}")
        if os.path.lexists(media / f".{name}.issue71.tmp"):
            fail(f"previous regeneration temp exists: {name}")

    image = importer.open_validated_source(source)
    if page.get("source_must_contain_color") and not image_has_color(image):
        fail("private source unexpectedly contains no color")

    return {
        "source": source,
        "media": media,
        "image": image,
        "catalog_bytes": catalog_path.read_bytes(),
    }


def generate_derivatives(importer, image: Image.Image) -> dict[str, bytes]:
    generated: dict[str, bytes] = {}

    thumb = importer.resized_copy(image, importer.THUMB_MAX_WIDTH)
    output = io.BytesIO()
    thumb.save(output, format="WEBP", lossless=True, quality=100, method=6)
    generated["thumb.webp"] = output.getvalue()

    preview = importer.resized_copy(image, importer.PREVIEW_MAX_WIDTH)
    output = io.BytesIO()
    preview.save(output, format="WEBP", lossless=True, quality=100, method=6)
    generated["preview.webp"] = output.getvalue()

    output = io.BytesIO()
    importer.build_print_image(image).save(output, format="PNG", optimize=True)
    generated["print.png"] = output.getvalue()

    source_rgba = image.convert("RGBA")
    for name, body in generated.items():
        if not body:
            fail(f"generated derivative is empty: {name}")
        try:
            with Image.open(io.BytesIO(body)) as candidate:
                candidate.load()
                if image_has_color(source_rgba) and not image_has_color(candidate):
                    fail(f"generated derivative lost source color: {name}")
                if name == "print.png":
                    candidate_rgba = candidate.convert("RGBA")
                    if (
                        candidate_rgba.size != source_rgba.size
                        or candidate_rgba.tobytes() != source_rgba.tobytes()
                    ):
                        fail("generated print PNG does not preserve source pixels")
        except OSError as exc:
            raise RegenerationError(
                f"generated derivative is undecodable: {name}"
            ) from exc

    return generated


def fsync_directory(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def write_exclusive(path: Path, body: bytes) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags, 0o644)
    except OSError as exc:
        raise RegenerationError(
            f"cannot create regeneration temp: {path.name}"
        ) from exc
    with os.fdopen(fd, "wb", buffering=0) as handle:
        handle.write(body)
        os.fsync(handle.fileno())


def verify_final(
    content_root: Path,
    contract: dict[str, Any],
    generated: dict[str, bytes],
    catalog_before: bytes,
) -> None:
    page = contract["page"]
    source = content_root / page["source_relative_path"]
    media = content_root / "public/media" / page["id"]
    catalog_path = content_root / "public/catalog.json"

    if (
        source.stat().st_size != page["source_size_bytes"]
        or sha256_file(source) != page["source_sha256"]
    ):
        fail("private source changed during regeneration")
    if catalog_path.read_bytes() != catalog_before:
        fail("catalog changed during regeneration")
    if catalog_entry(content_root, page["id"]) != page["catalog_entry"]:
        fail("catalog metadata changed during regeneration")

    for name in FILES:
        path = media / name
        new_sha = sha256_file(path)
        if new_sha != sha256_bytes(generated[name]):
            fail(f"published derivative does not match staged output: {name}")
        if new_sha == page["current_derivatives"][name]["sha256"]:
            fail(f"published derivative did not change from legacy baseline: {name}")


def execute(
    content_root: Path,
    contract: dict[str, Any],
    *,
    apply: bool,
) -> dict[str, str]:
    importer = load_importer()
    validate_contract_shape(contract)
    lock_path = content_root / contract["runtime"]["shared_lock"]
    if not lock_path.is_file():
        fail("shared Drive-ingest lock is missing")

    with lock_path.open("r+b", buffering=0) as lock_handle:
        try:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RegenerationError("another content operation is active") from exc

        state = preflight(content_root, contract, importer)
        generated = generate_derivatives(importer, state["image"])
        result = {name: sha256_bytes(body) for name, body in generated.items()}

        if not apply:
            return result

        media: Path = state["media"]
        temp_paths = {
            name: media / f".{name}.issue71.tmp" for name in FILES
        }

        # Fail closed. No retry, rollback, or cleanup after the first temp write.
        for name in FILES:
            write_exclusive(temp_paths[name], generated[name])
        fsync_directory(media)

        for name in FILES:
            os.replace(temp_paths[name], media / name)
            fsync_directory(media)

        verify_final(
            content_root,
            contract,
            generated,
            state["catalog_bytes"],
        )
        return result


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--apply", action="store_true")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    try:
        args = parse_args(argv)
        contract = load_contract()
        result = execute(CONTENT_ROOT, contract, apply=args.apply)
        outcome = "APPLY" if args.apply else "CHECK"
        print(
            f"DERIVATIVE_REGEN_{outcome}=PASS ID=farben-zuordnen-001"
        )
        for name in FILES:
            label = name.upper().replace(".", "_")
            print(f"{label}_SHA256={result[name]}")
        return 0
    except RegenerationError as exc:
        print(f"DERIVATIVE_REGEN=FAIL error={exc}", file=sys.stderr)
        return 1
    except Exception:
        print(
            "DERIVATIVE_REGEN=FAIL error=unexpected-regeneration-error",
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
