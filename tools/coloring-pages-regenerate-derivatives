#!/usr/bin/env python3
"""Publish corrected existing derivatives under cache-safe immutable identities."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import sys
from pathlib import Path
from typing import Any

CONTENT_ROOT = Path("/srv/coloring-pages-content")
CONTRACT_SCHEMA = "rozkalns.coloring-pages.existing-derivative-regeneration.v1"
CONTAINER_CONTRACT = Path(
    "/usr/local/share/coloring-pages/existing-derivative-regeneration-v1.json"
)
FILES = ("thumb.webp", "preview.webp", "print.png")
MEDIA_FIELDS = ("thumb", "preview", "print")


class RegenerationError(RuntimeError):
    """Fail-closed existing-media correction error."""


def fail(message: str) -> None:
    raise RegenerationError(message)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def contract_path() -> Path:
    if CONTAINER_CONTRACT.is_file():
        return CONTAINER_CONTRACT
    return Path(__file__).resolve().parents[1] / (
        "deploy/existing-derivative-regeneration-v1.json"
    )


def load_contract() -> dict[str, Any]:
    try:
        raw = json.loads(contract_path().read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise RegenerationError("regeneration contract is unavailable or invalid") from exc
    if not isinstance(raw, dict) or raw.get("schema") != CONTRACT_SCHEMA:
        fail("regeneration contract schema mismatch")
    return raw


def read_catalog(path: Path) -> list[dict[str, Any]]:
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise RegenerationError("catalog is unavailable or invalid") from exc
    if not isinstance(raw, list):
        fail("catalog must be a JSON array")
    if not all(isinstance(item, dict) for item in raw):
        fail("catalog contains an invalid entry")
    return raw


def catalog_index(catalog: list[dict[str, Any]], page_id: str) -> int:
    matches = [index for index, item in enumerate(catalog) if item.get("id") == page_id]
    if len(matches) != 1:
        fail("catalog page identity is missing or ambiguous")
    return matches[0]


def content_addressed_filename(name: str, sha256: str) -> str:
    path = Path(name)
    return f"{path.stem}-{sha256}{path.suffix}"


def validate_contract_shape(contract: dict[str, Any]) -> None:
    page = contract.get("page")
    runtime = contract.get("runtime")
    cache = contract.get("cache_identity")
    mutation = contract.get("mutation")
    if contract.get("issue") != 74 or not isinstance(page, dict):
        fail("contract issue/page mismatch")
    if page.get("id") != "farben-zuordnen-001":
        fail("contract page id mismatch")
    if runtime != {
        "content_root": "/srv/coloring-pages-content",
        "shared_lock": "state/drive-ingest/.lock",
        "regenerator_entrypoint": "/usr/local/bin/coloring-pages-regenerate-derivatives",
    }:
        fail("contract runtime identity mismatch")
    if cache != {
        "strategy": "full-sha256-content-addressed-filename",
        "stable_immutable_urls_must_not_be_overwritten": True,
        "catalog_is_switch_point": True,
    }:
        fail("cache identity contract mismatch")

    corrected = page.get("corrected_derivatives")
    if not isinstance(corrected, dict) or set(corrected) != set(FILES):
        fail("corrected derivative baseline mismatch")
    for name in FILES:
        item = corrected[name]
        sha = item.get("sha256")
        size = item.get("size_bytes")
        filename = item.get("versioned_filename")
        if (
            not isinstance(sha, str)
            or len(sha) != 64
            or not isinstance(size, int)
            or size <= 0
            or filename != content_addressed_filename(name, sha)
        ):
            fail(f"corrected derivative identity is invalid: {name}")

    before = page.get("catalog_entry_before")
    after = page.get("catalog_entry_after")
    if not isinstance(before, dict) or not isinstance(after, dict):
        fail("catalog entry contract is invalid")
    for key, value in before.items():
        if key not in MEDIA_FIELDS and after.get(key) != value:
            fail("catalog non-media metadata differs in contract")
    for field, name in zip(MEDIA_FIELDS, FILES):
        expected = f"/media/{page['id']}/{corrected[name]['versioned_filename']}"
        if after.get(field) != expected:
            fail(f"catalog content-addressed URL mismatch: {field}")

    expected_new_targets = [
        f"public/media/{page['id']}/{corrected[name]['versioned_filename']}"
        for name in FILES
    ]
    if mutation.get("allowed_new_targets") != expected_new_targets:
        fail("allowed content-addressed targets mismatch")
    if mutation.get("stable_media_must_remain_unchanged") != [
        f"public/media/{page['id']}/{name}" for name in FILES
    ]:
        fail("stable-media preservation contract mismatch")
    if mutation.get("catalog_target") != "public/catalog.json":
        fail("catalog target mismatch")
    if mutation.get("catalog_mutation_scope") != list(MEDIA_FIELDS):
        fail("catalog mutation scope mismatch")
    if mutation.get("forbidden_targets") != [
        f"originals/{page['id']}/source.png"
    ]:
        fail("forbidden target contract mismatch")


def preflight(content_root: Path, contract: dict[str, Any]) -> dict[str, Any]:
    validate_contract_shape(contract)
    page = contract["page"]
    page_id = page["id"]
    source = content_root / page["source_relative_path"]
    media = content_root / "public/media" / page_id
    catalog_path = content_root / "public/catalog.json"
    lock_path = content_root / contract["runtime"]["shared_lock"]

    if not content_root.is_dir() or not media.is_dir() or not lock_path.is_file():
        fail("required content layout is missing")
    if not source.is_file():
        fail("private source is missing")
    if source.stat().st_size != page["source_size_bytes"]:
        fail("private source size drifted")
    if sha256_file(source) != page["source_sha256"]:
        fail("private source sha256 drifted")

    catalog = read_catalog(catalog_path)
    index = catalog_index(catalog, page_id)
    if catalog[index] != page["catalog_entry_before"]:
        fail("catalog baseline drifted")

    stable_bytes: dict[str, bytes] = {}
    for name in FILES:
        stable = media / name
        baseline = page["corrected_derivatives"][name]
        if not stable.is_file():
            fail(f"corrected stable derivative is missing: {name}")
        if stable.stat().st_size != baseline["size_bytes"]:
            fail(f"corrected derivative size drifted: {name}")
        if sha256_file(stable) != baseline["sha256"]:
            fail(f"corrected derivative sha256 drifted: {name}")
        stable_bytes[name] = stable.read_bytes()

        versioned = media / baseline["versioned_filename"]
        if os.path.lexists(versioned):
            fail(f"content-addressed target already exists: {versioned.name}")

    catalog_temp = catalog_path.parent / f".catalog.{page_id}.issue74.tmp"
    if os.path.lexists(catalog_temp):
        fail("catalog switch temp already exists")

    expected_catalog = [dict(item) for item in catalog]
    expected_catalog[index] = dict(page["catalog_entry_after"])

    return {
        "source": source,
        "media": media,
        "catalog_path": catalog_path,
        "catalog": catalog,
        "expected_catalog": expected_catalog,
        "stable_bytes": stable_bytes,
        "catalog_temp": catalog_temp,
    }


def fsync_directory(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def write_exclusive(path: Path, body: bytes) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags, 0o644)
    except OSError as exc:
        raise RegenerationError(
            f"cannot create content-addressed media: {path.name}"
        ) from exc
    with os.fdopen(fd, "wb", buffering=0) as handle:
        handle.write(body)
        os.fsync(handle.fileno())


def serialize_catalog(catalog: list[dict[str, Any]]) -> bytes:
    return (json.dumps(catalog, ensure_ascii=False, indent=2) + "\n").encode("utf-8")


def verify_final(
    content_root: Path,
    contract: dict[str, Any],
    state: dict[str, Any],
) -> None:
    page = contract["page"]
    source = content_root / page["source_relative_path"]
    media = state["media"]

    if (
        source.stat().st_size != page["source_size_bytes"]
        or sha256_file(source) != page["source_sha256"]
    ):
        fail("private source changed during cache-safe publication")

    for name in FILES:
        baseline = page["corrected_derivatives"][name]
        stable = media / name
        versioned = media / baseline["versioned_filename"]
        body = state["stable_bytes"][name]
        expected_sha = baseline["sha256"]

        if stable.read_bytes() != body or sha256_file(stable) != expected_sha:
            fail(f"stable immutable media changed: {name}")
        if (
            not versioned.is_file()
            or versioned.stat().st_size != len(body)
            or sha256_file(versioned) != expected_sha
            or versioned.read_bytes() != body
        ):
            fail(f"content-addressed media verification failed: {name}")

    final_catalog = read_catalog(state["catalog_path"])
    if final_catalog != state["expected_catalog"]:
        fail("catalog switch verification failed")


def execute(
    content_root: Path,
    contract: dict[str, Any],
    *,
    apply: bool,
) -> dict[str, str]:
    validate_contract_shape(contract)
    lock_path = content_root / contract["runtime"]["shared_lock"]
    if not lock_path.is_file():
        fail("shared Drive-ingest lock is missing")

    with lock_path.open("r+b", buffering=0) as lock_handle:
        try:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise RegenerationError("another content operation is active") from exc

        state = preflight(content_root, contract)
        page = contract["page"]
        result = {
            name: page["corrected_derivatives"][name]["versioned_filename"]
            for name in FILES
        }

        if not apply:
            return result

        # Fail closed: after the first persistent write, no retry, rollback,
        # cleanup, or alternate mutation path is attempted automatically.
        for name in FILES:
            target = state["media"] / result[name]
            write_exclusive(target, state["stable_bytes"][name])
        fsync_directory(state["media"])

        catalog_body = serialize_catalog(state["expected_catalog"])
        write_exclusive(state["catalog_temp"], catalog_body)
        os.replace(state["catalog_temp"], state["catalog_path"])
        fsync_directory(state["catalog_path"].parent)

        verify_final(content_root, contract, state)
        return result


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--apply", action="store_true")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    try:
        args = parse_args(argv)
        contract = load_contract()
        result = execute(CONTENT_ROOT, contract, apply=args.apply)
        outcome = "APPLY" if args.apply else "CHECK"
        print(
            f"CACHE_SAFE_DERIVATIVE_{outcome}=PASS ID=farben-zuordnen-001"
        )
        for name in FILES:
            label = name.upper().replace(".", "_")
            print(f"{label}_FILE={result[name]}")
        return 0
    except RegenerationError as exc:
        print(f"CACHE_SAFE_DERIVATIVE=FAIL error={exc}", file=sys.stderr)
        return 1
    except Exception:
        print(
            "CACHE_SAFE_DERIVATIVE=FAIL error=unexpected-publication-error",
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
