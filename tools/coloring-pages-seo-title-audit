#!/usr/bin/env python3
"""Read-only title-collision inventory for a supplied published catalogue snapshot.

Title collisions are review candidates, *not* proof of duplicate artwork.
This tool never reads/downloads images, rewrites metadata, or selects canonicals.
"""

import argparse
import hashlib
import json
import re
import sys
import unicodedata
from collections import defaultdict
from pathlib import Path


MAX_CATALOG_BYTES = 16 * 1024 * 1024


def title_key(title):
    return unicodedata.normalize("NFKC", " ".join(title.split())).casefold()


def build_report(data, catalog_digest):
    if not isinstance(data, list):
        raise ValueError("catalogue must be an array")
    groups = defaultdict(list)
    ids = set()
    for position, item in enumerate(data):
        if not isinstance(item, dict):
            raise ValueError(f"record {position} must be an object")
        activity_id, title = item.get("id"), item.get("title")
        if not isinstance(activity_id, str) or not activity_id:
            raise ValueError(f"record {position} has invalid id")
        if activity_id in ids:
            raise ValueError(f"duplicate activity id {activity_id}")
        ids.add(activity_id)
        if not isinstance(title, str) or not title.strip():
            raise ValueError(f"record {position} has invalid title")
        for key in ("categories", "topics"):
            if key in item and (not isinstance(item[key], list) or
                                any(not isinstance(v, str) for v in item[key])):
                raise ValueError(f"record {position} has invalid {key}")
        groups[title_key(title)].append({
            "id": activity_id,
            "title": title,
            "categories": item.get("categories", [item.get("category")] if item.get("category") else []),
            "topics": item.get("topics", []),
            "preview": item.get("preview"),
            "print": item.get("print"),
        })
    collisions = [
        {
            "normalized_title": key,
            "entries": sorted(entries, key=lambda entry: entry["id"]),
            "artwork_identity": "unverified",
        }
        for key, entries in sorted(groups.items()) if len(entries) > 1
    ]
    return {
        "catalog_sha256": catalog_digest,
        "activity_count": len(data),
        "title_collision_group_count": len(collisions),
        "title_collision_activity_count": sum(len(g["entries"]) for g in collisions),
        "note": "Matching titles are not evidence of identical artwork. Do not auto-redirect or change canonicals.",
        "groups": collisions,
    }


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--catalog", type=Path, required=True, help="read-only local catalog.json snapshot")
    parser.add_argument("--expected-catalog-sha256", help="optional exact SHA-256 snapshot binding")
    args = parser.parse_args(argv)
    if args.expected_catalog_sha256 is not None and not re.fullmatch(r"[0-9a-f]{64}", args.expected_catalog_sha256):
        parser.error("expected catalogue SHA-256 must be 64 lowercase hex characters")
    try:
        with args.catalog.open("rb") as file:
            raw = file.read(MAX_CATALOG_BYTES + 1)
        if len(raw) > MAX_CATALOG_BYTES:
            raise ValueError("catalogue exceeds 16 MiB read-only bound")
        digest = hashlib.sha256(raw).hexdigest()
        if args.expected_catalog_sha256 is not None and digest != args.expected_catalog_sha256:
            raise ValueError("catalogue SHA-256 mismatch")
        data = json.loads(raw.decode("utf-8"))
        report = build_report(data, digest)
    except (OSError, ValueError, UnicodeError, json.JSONDecodeError) as error:
        print(f"SEO_AUDIT_ERROR: {error}", file=sys.stderr)
        return 2
    print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
