#!/usr/bin/env python3
"""Cut & Paste source SVG exporter, issue #220; NOT print/assembly approval (#221)."""
import argparse
import hashlib
import json
import math
import subprocess
from pathlib import Path
from xml.sax.saxutils import escape
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent))
from cut_paste_geometry import outline_d, validate_scene, validate_png

A4 = (2480, 3508)
INK = (17, 17, 193, 256)

def a(value):
    return escape(str(value), {'"': '&quot;'})

def n(value):
    return f"{value:.5f}".rstrip('0').rstrip('.') if isinstance(value, float) else str(value)

def page(content, width=210, height=297):
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{n(width)}mm" '
            f'height="{n(height)}mm" viewBox="0 0 {n(width)} {n(height)}">'
            f'<rect width="{n(width)}" height="{n(height)}" fill="#FFFFFF"/>'
            f'{content}</svg>\n')

def transform(part):
    t = part["assembly"]
    x, y = t["translate_mm"]
    return f'translate({n(x)} {n(y)}) rotate({n(t["rotate_deg"])}) scale({n(t["scale"])})'

def part_svg(part, cut=False, style=None):
    art = part["art"]
    path = a(art["outer_path_d"])
    parts = [f'<g data-part-id="{a(part["id"])}">',
             f'<path d="{path}" fill="{a(art["fill"])}" stroke="{a(art["stroke"])}" stroke-width="{n(art["stroke_width_mm"])}"/>']
    for inside in art["interior"]:
        parts.append(f'<path d="{a(inside["path_d"])}" fill="{a(inside["fill"])}" '
                     f'stroke="{a(inside.get("stroke", "none"))}" stroke-width="{n(inside.get("stroke_width_mm",0))}"/>')
    if cut:
        # The contour is based on the exact outer path; geometrical offset QA is #221.
        off = part["cut"]["offset_mm"]
        guide = a(outline_d(part))
        parts.append(f'<path data-cut-for="{a(part["id"])}" d="{guide}" fill="none" '
                     f'stroke="{a(style["color"])}" stroke-width="{n(style["stroke_width_mm"])}" '
                     f'stroke-dasharray="{n(style["dash_mm"])} {n(style["gap_mm"])}"/>')
    return "".join(parts) + "</g>"

def bounding(part):
    t = part["assembly"]
    x,y=t["translate_mm"]
    w,h=part["art"]["size_mm"]
    s=t["scale"]
    theta=math.radians(t["rotate_deg"])
    points=[(x+s*(dx*math.cos(theta)-dy*math.sin(theta)),
             y+s*(dx*math.sin(theta)+dy*math.cos(theta)))
            for dx,dy in ((0,0),(w,0),(w,h),(0,h))]
    return (min(p[0] for p in points),min(p[1] for p in points),
            max(p[0] for p in points),max(p[1] for p in points))

def union(rects):
    return tuple(f(r[i] for r in rects) for i,f in enumerate((min,min,max,max)))

def overlap(p,q,gap=0):
    return not (p[2]+gap<=q[0] or q[2]+gap<=p[0] or p[3]+gap<=q[1] or q[3]+gap<=p[1])

def check(source):
    if source["schema"]!="ausmalwiese.cut-paste.character.v1" or source["preview_source"]!="recompose-exact-parts":
        raise ValueError("Wrong source contract")
    pt=source["print_target"]
    if pt["raster_px"]!=list(A4) or pt["color_mode"]!="RGB" or pt["dpi"]!=300:
        raise ValueError("Wrong A4 raster target")
    if tuple(source["page_layout"]["ink_box_mm"])!=INK:
        raise ValueError("Wrong footer-safe ink area")
    parts=source["parts"]
    ids=[p["id"] for p in parts]
    features=[p["feature"] for p in parts]
    if len(ids)!=len(set(ids)) or len(features)!=len(set(features)):
        raise ValueError("Duplicated part id or feature")
    bases=[p for p in parts if p["role"]=="base"]
    if len(bases)!=1: raise ValueError("Expected exactly one base")
    if set(bases[0]["built_in_features"]) & set(features):
        raise ValueError("Integrated feature also detachable")
    for part in parts:
        if part["cut"]["method"]!="offset-of-outer-path":
            raise ValueError("Wrong cutting method")
        if part["role"]=="cutout":
            glue=part["glue"]
            if not glue or glue["side"]!="front" or glue["target_id"] not in ids or glue["target_id"]==part["id"]:
                raise ValueError("Unplaceable cutout")
    return parts,bases[0]

def pack(parts,style):
    # Large pieces occupy full-width rows, all others are in two deterministic columns.
    cutouts=[p for p in parts if p["role"]=="cutout"]
    left,top,right,bottom=INK
    width=(right-left-8)/2
    large=[];small=[]
    for p in cutouts:
        w=p["art"]["size_mm"][0]
        margin=p["cut"]["offset_mm"]+style["stroke_width_mm"]
        if w+2*margin>right-left: raise ValueError("Cutout exceeds A4 width")
        (large if w+2*margin>width else small).append(p)
    large.sort(key=lambda p:p["id"])
    small.sort(key=lambda p:(-p["art"]["size_mm"][1],p["id"]))
    placed=[]
    level=top
    for p in large:
        w,h=p["art"]["size_mm"]
        m=p["cut"]["offset_mm"]+style["stroke_width_mm"]
        x=left+(right-left-w)/2
        y=level+m
        if y+h+m>bottom: raise ValueError("A4 parts page overflow")
        placed.append((p,x,y))
        level=y+h+m+8
    heights=[level,level]
    for p in small:
        w,h=p["art"]["size_mm"]
        m=p["cut"]["offset_mm"]+style["stroke_width_mm"]
        i=min(range(2),key=lambda z:heights[z])
        x=left+i*(width+8)+(width-w)/2
        y=heights[i]+m
        if y+h+m>bottom: raise ValueError("A4 parts page overflow")
        placed.append((p,x,y))
        heights[i]=y+h+m+8
    return placed

def render(source):
    parts,base=check(source)
    sorted_parts=sorted(parts,key=lambda p:p["assembly"]["z_index"])
    bounds=union([bounding(p) for p in parts])
    x1,y1,x2,y2=bounds
    left,top,right,bottom=INK
    if x1-3<left or y1-3<top or x2+3>right or y2+3>bottom:
        raise ValueError("Assembled subject exceeds ink box")
    box=source["page_layout"]["preview_box_mm"]
    pr=(box[0],box[1],box[0]+box[2],box[1]+box[3])
    if pr[0]<left or pr[1]<top or pr[2]>right or pr[3]>bottom:
        raise ValueError("Preview outside ink box")
    if overlap(pr,(x1-3,y1-3,x2+3,y2+3),2):
        raise ValueError("Preview overlaps finished silhouette")
    s=min(box[2]/(x2-x1),box[3]/(y2-y1))
    tx=box[0]+(box[2]-(x2-x1)*s)/2-x1*s
    ty=box[1]+(box[3]-(y2-y1)*s)/2-y1*s
    assembled="".join(f'<g transform="{transform(p)}">{part_svg(p)}</g>' for p in sorted_parts)
    preview=f'<g id="assembled-preview" transform="translate({n(tx)} {n(ty)}) scale({n(s)})">{assembled}</g>'
    body=page(f'<g id="base" transform="{transform(base)}">{part_svg(base,True,source["cut_style"])}</g>'+preview)
    placed=pack(parts,source["cut_style"])
    geometry_qa=validate_scene(parts,placed,source["cut_style"],pr,source["page_layout"]["assembled_origin_mm"])
    cutout=page('<g id="cutout-sheet">'+''.join(f'<g transform="translate({n(x)} {n(y)})">{part_svg(p,True,source["cut_style"])}</g>' for p,x,y in placed)+'</g>')
    proof=page('<g id="assembled-proof">'+assembled+'</g>')
    return {"01-base.svg":body,"02-cutouts.svg":cutout,"03-assembly-proof.svg":proof}, {
        "parts":[p["id"] for p in parts],
        "cutouts":[{"id":p["id"],"x_mm":x,"y_mm":y} for p,x,y in placed],
        "assembled_bounds_mm":list(bounds),"preview_bounds_mm":list(pr),
        "preview_scale":s,"geometry_qa":geometry_qa,"review_status":"DRAFT_ONLY; physical assembly not checked",
        "art_review":{"status":"PENDING","human_visual_approval":False,
                      "reason":"Illustration quality and finished reference need explicit human review #221"}}

def png(svg,path,inkscape):
    import PIL.Image
    subprocess.run([inkscape,str(svg),"--export-type=png",f"--export-filename={path}",
                    "--export-width=2480","--export-height=3508"],
                   check=True,stderr=subprocess.PIPE,timeout=90)
    with PIL.Image.open(path) as original:
        if original.size!=A4: raise ValueError("Bad raster size")
        original.convert("RGB").save(path,dpi=(300,300))

def main():
    ap=argparse.ArgumentParser(description=__doc__)
    ap.add_argument("source",type=Path)
    ap.add_argument("output",type=Path)
    ap.add_argument("--inkscape",default="inkscape")
    args=ap.parse_args()
    data=args.source.read_bytes()
    pages,manifest=render(json.loads(data))
    if args.output.exists() and any(args.output.iterdir()):
        raise SystemExit("STOP: output directory not empty; refusing overwrite")
    try:
        subprocess.run([args.inkscape,"--version"],check=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=15)
    except (OSError,subprocess.CalledProcessError,subprocess.TimeoutExpired) as e:
        raise SystemExit(f"STOP: Inkscape not available: {e}")
    args.output.mkdir(parents=True,exist_ok=True)
    for name,svg in pages.items(): (args.output/name).write_text(svg,"utf-8")
    for stem in ("01-base","02-cutouts"):
        png(args.output/(stem+".svg"),args.output/(stem+".png"),args.inkscape)
    manifest["raster_ink_bounds_mm"]={name:validate_png(args.output/name) for name in ("01-base.png","02-cutouts.png")}
    manifest["source_sha256"]=hashlib.sha256(data).hexdigest()
    manifest["files_sha256"]={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(args.output.iterdir())}
    (args.output/"04-manifest.json").write_text(json.dumps(manifest,indent=2,sort_keys=True)+"\n","utf-8")
    print("DRAFT ONLY, NOT VALIDATED FOR PUBLISH:",args.output)

if __name__=="__main__": main()
