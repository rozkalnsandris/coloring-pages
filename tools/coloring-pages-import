#!/usr/bin/env python3
"""Import one coloring-page activity with one or more PNG pages safely."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sys
import tempfile
from pathlib import Path
from typing import Any

from PIL import Image, ImageOps, UnidentifiedImageError

ID_PATTERN = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
A4_WIDTH_MM = 210
A4_HEIGHT_MM = 297
A4_RATIO = A4_WIDTH_MM / A4_HEIGHT_MM
MIN_SOURCE_RATIO = 2 / 3
MAX_SOURCE_RATIO = A4_RATIO + 0.04
MIN_SOURCE_WIDTH = 800
MIN_SOURCE_HEIGHT = 1100
MAX_ACTIVITY_PAGES = 12
THUMB_MAX_WIDTH = 400
PREVIEW_MAX_WIDTH = 1000
ALLOWED_AGES = {"3-6", "4-8"}
ALLOWED_DIFFICULTIES = {"easy", "normal", "detailed"}
ALLOWED_LANGUAGES = {"de"}
CATEGORY_REGISTRY_SCHEMA = "rozkalns.coloring-pages.categories.v1"
CONTAINER_CATEGORY_REGISTRY = Path("/usr/local/share/coloring-pages/categories.json")


class ImportError(ValueError):
    """Raised when an activity cannot be imported safely."""


def category_registry_path() -> Path:
    if CONTAINER_CATEGORY_REGISTRY.is_file():
        return CONTAINER_CATEGORY_REGISTRY
    return Path(__file__).resolve().parents[1] / "metadata/categories.json"


def load_allowed_categories() -> frozenset[str]:
    path = category_registry_path()
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ImportError(f"category registry is unavailable or invalid: {path}") from exc

    if not isinstance(raw, dict) or raw.get("schema") != CATEGORY_REGISTRY_SCHEMA:
        raise ImportError("category registry schema is invalid")
    categories = raw.get("categories")
    if not isinstance(categories, list) or not categories:
        raise ImportError("category registry must contain at least one category")

    ids: set[str] = set()
    for category in categories:
        if not isinstance(category, dict):
            raise ImportError("category registry contains an invalid entry")
        category_id = category.get("id")
        label = category.get("label")
        if (
            not isinstance(category_id, str)
            or not ID_PATTERN.fullmatch(category_id)
            or not isinstance(label, str)
            or not label.strip()
        ):
            raise ImportError("category registry contains an invalid id or label")
        if category_id in ids:
            raise ImportError(f"category registry contains duplicate id: {category_id}")
        ids.add(category_id)

    return frozenset(ids)


def slug_from_path(path: Path) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", path.stem.lower()).strip("-")
    if not slug or not ID_PATTERN.fullmatch(slug):
        raise ImportError("cannot derive a safe page id from the file name")
    return slug


def default_title(page_id: str) -> str:
    return " ".join(part.capitalize() for part in page_id.split("-"))


def validate_metadata(metadata: dict[str, str]) -> None:
    page_id = metadata["id"]
    if not ID_PATTERN.fullmatch(page_id):
        raise ImportError(f"id must match {ID_PATTERN.pattern}")
    if metadata["age"] not in ALLOWED_AGES:
        raise ImportError(f"age must be one of {', '.join(sorted(ALLOWED_AGES))}")
    if metadata["difficulty"] not in ALLOWED_DIFFICULTIES:
        raise ImportError(
            f"difficulty must be one of {', '.join(sorted(ALLOWED_DIFFICULTIES))}"
        )
    if metadata["language"] not in ALLOWED_LANGUAGES:
        raise ImportError(
            f"language must be one of {', '.join(sorted(ALLOWED_LANGUAGES))}"
        )
    if not metadata["title"].strip():
        raise ImportError("title must be a non-empty string")
    allowed_categories = load_allowed_categories()
    if metadata["category"] not in allowed_categories:
        raise ImportError(
            f"category must be one of {', '.join(sorted(allowed_categories))}"
        )


def validate_source_paths(source_paths: list[Path], inbox_root: Path) -> list[Path]:
    if not source_paths:
        raise ImportError("at least one source page is required")
    if len(source_paths) > MAX_ACTIVITY_PAGES:
        raise ImportError(f"activity may contain at most {MAX_ACTIVITY_PAGES} pages")

    resolved: list[Path] = []
    seen: set[Path] = set()
    for source_path in source_paths:
        path = source_path.resolve()
        try:
            path.relative_to(inbox_root)
        except ValueError as exc:
            raise ImportError("source must be inside the content inbox") from exc
        if path.parent != inbox_root:
            raise ImportError("source must be a direct child of the content inbox")
        if path in seen:
            raise ImportError("source page is listed more than once")
        seen.add(path)
        resolved.append(path)
    return resolved


def open_validated_source(path: Path) -> Image.Image:
    if not path.is_file():
        raise ImportError(f"input file does not exist: {path}")
    try:
        with Image.open(path) as source:
            source.load()
            if source.format != "PNG":
                raise ImportError("source must be PNG")
            image = ImageOps.exif_transpose(source).convert("RGBA")
    except UnidentifiedImageError as exc:
        raise ImportError("source is not a decodable image") from exc
    except OSError as exc:
        raise ImportError(f"failed to decode source: {exc}") from exc

    if image.width >= image.height:
        raise ImportError("source must use portrait orientation")
    if image.width < MIN_SOURCE_WIDTH or image.height < MIN_SOURCE_HEIGHT:
        raise ImportError(
            f"source must be at least {MIN_SOURCE_WIDTH}x{MIN_SOURCE_HEIGHT} pixels"
        )
    ratio = image.width / image.height
    if not MIN_SOURCE_RATIO <= ratio <= MAX_SOURCE_RATIO:
        raise ImportError(
            f"source must be approximately A4/2:3 portrait ratio; got {image.width}x{image.height}"
        )

    corners = (
        image.getpixel((0, 0)),
        image.getpixel((image.width - 1, 0)),
        image.getpixel((0, image.height - 1)),
        image.getpixel((image.width - 1, image.height - 1)),
    )
    if any(min(pixel[:3]) < 240 for pixel in corners):
        raise ImportError("source page corners must be white/light")

    return image


def resized_copy(image: Image.Image, max_width: int) -> Image.Image:
    copy = image.copy()
    copy.thumbnail(
        (max_width, round(max_width / A4_RATIO)),
        Image.Resampling.LANCZOS,
    )
    return copy


def build_print_image(image: Image.Image) -> Image.Image:
    """Create an original-size public print PNG without recoloring source pixels."""
    return image.copy()


def source_filename(index: int, page_count: int) -> str:
    return "source.png" if page_count == 1 else f"source-{index}.png"


def preview_filename(index: int, page_count: int) -> str:
    return "preview.webp" if page_count == 1 else f"preview-{index}.webp"


def print_filename(index: int, page_count: int) -> str:
    return "print.png" if page_count == 1 else f"print-{index}.png"


def build_derivatives(images: list[Image.Image], target: Path) -> None:
    target.mkdir(parents=True, exist_ok=False)

    thumb = resized_copy(images[0], THUMB_MAX_WIDTH)
    thumb.save(target / "thumb.webp", format="WEBP", lossless=True, quality=100, method=6)

    page_count = len(images)
    for index, image in enumerate(images, start=1):
        preview = resized_copy(image, PREVIEW_MAX_WIDTH)
        preview.save(
            target / preview_filename(index, page_count),
            format="WEBP",
            lossless=True,
            quality=100,
            method=6,
        )
        build_print_image(image).save(
            target / print_filename(index, page_count),
            format="PNG",
            optimize=True,
        )


def load_catalog(path: Path) -> list[dict[str, Any]]:
    if not path.exists():
        return []
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise ImportError(f"published catalog is invalid JSON: {exc.msg}") from exc
    if not isinstance(raw, list):
        raise ImportError("published catalog must be a JSON array")

    seen: set[str] = set()
    for entry in raw:
        if not isinstance(entry, dict) or not isinstance(entry.get("id"), str):
            raise ImportError("published catalog contains an invalid entry")
        page_id = entry["id"]
        if not ID_PATTERN.fullmatch(page_id):
            raise ImportError(f"published catalog contains invalid id: {page_id}")
        if page_id in seen:
            raise ImportError(f"published catalog contains duplicate id: {page_id}")
        seen.add(page_id)
    return raw


def build_catalog_entry(
    metadata: dict[str, str],
    page_count: int = 1,
) -> dict[str, Any]:
    page_id = metadata["id"]
    root = f"/media/{page_id}"
    entry: dict[str, Any] = {
        "id": page_id,
        "title": metadata["title"],
        "character": metadata["character"],
        "category": metadata["category"],
        "age": metadata["age"],
        "difficulty": metadata["difficulty"],
        "language": metadata["language"],
        "thumb": f"{root}/thumb.webp",
    }

    pages = [
        {
            "preview": f"{root}/{preview_filename(index, page_count)}",
            "print": f"{root}/{print_filename(index, page_count)}",
        }
        for index in range(1, page_count + 1)
    ]
    entry["preview"] = pages[0]["preview"]
    entry["print"] = pages[0]["print"]
    if page_count > 1:
        entry["pages"] = pages
    return entry


def serialize_catalog(entries: list[dict[str, Any]]) -> str:
    """Preserve canonical newest-first catalogue order exactly as supplied."""
    return json.dumps(entries, ensure_ascii=False, indent=2) + "\n"


def import_activity(
    source_paths: list[Path],
    content_root: Path,
    metadata: dict[str, str],
) -> dict[str, Any]:
    content_root = content_root.resolve()

    inbox_root = content_root / "inbox"
    originals_root = content_root / "originals"
    public_root = content_root / "public"
    media_root = public_root / "media"
    state_root = content_root / "state"
    catalog_path = public_root / "catalog.json"

    if not content_root.is_dir():
        raise ImportError("content root must already exist")
    for required_dir in (
        inbox_root,
        originals_root,
        public_root,
        media_root,
        state_root,
    ):
        if not required_dir.is_dir():
            raise ImportError(f"required content directory is missing: {required_dir}")
    if not catalog_path.is_file():
        raise ImportError("published catalog must already exist")

    sources = validate_source_paths(source_paths, inbox_root)
    validate_metadata(metadata)
    images = [open_validated_source(path) for path in sources]

    page_id = metadata["id"]
    final_original = originals_root / page_id
    final_media = media_root / page_id

    existing = load_catalog(catalog_path)
    if any(entry["id"] == page_id for entry in existing):
        raise ImportError(f"duplicate page id: {page_id}")
    if final_original.exists() or final_media.exists():
        raise ImportError(f"page id already exists on disk: {page_id}")

    entry = build_catalog_entry(metadata, len(images))
    new_catalog = serialize_catalog([entry, *existing])

    with tempfile.TemporaryDirectory(prefix=f"{page_id}-", dir=state_root) as temp_name:
        stage = Path(temp_name)
        stage_original = stage / "originals" / page_id
        stage_media = stage / "media" / page_id
        stage_catalog = stage / "catalog.json"

        stage_original.mkdir(parents=True)
        for index, source_path in enumerate(sources, start=1):
            shutil.copyfile(
                source_path,
                stage_original / source_filename(index, len(sources)),
            )
        build_derivatives(images, stage_media)
        stage_catalog.write_text(new_catalog, encoding="utf-8")

        os.replace(stage_original, final_original)
        os.replace(stage_media, final_media)

        catalog_tmp = public_root / f".catalog.{page_id}.{os.getpid()}.tmp"
        shutil.copyfile(stage_catalog, catalog_tmp)
        os.chmod(catalog_tmp, 0o644)
        os.replace(catalog_tmp, catalog_path)

    return entry


def import_page(
    source_path: Path,
    content_root: Path,
    metadata: dict[str, str],
) -> dict[str, Any]:
    """Backward-compatible one-page import API."""
    return import_activity([source_path], content_root, metadata)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", nargs="+", type=Path)
    parser.add_argument(
        "--content-root",
        type=Path,
        default=Path("/srv/coloring-pages-content"),
    )
    parser.add_argument("--id", dest="page_id")
    parser.add_argument("--title")
    parser.add_argument("--character", default="")
    parser.add_argument("--category", required=True)
    parser.add_argument("--age", default="3-6")
    parser.add_argument("--difficulty", default="easy")
    parser.add_argument("--language", default="de")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        if args.page_id:
            page_id = args.page_id
        elif len(args.source) == 1:
            page_id = slug_from_path(args.source[0])
        else:
            raise ImportError("--id is required when importing multiple pages")

        metadata = {
            "id": page_id,
            "title": args.title or default_title(page_id),
            "character": args.character.strip(),
            "category": args.category.strip(),
            "age": args.age.strip(),
            "difficulty": args.difficulty.strip(),
            "language": args.language.strip(),
        }
        entry = import_activity(args.source, args.content_root, metadata)
    except ImportError as exc:
        print(f"IMPORT_ERROR: {exc}", file=sys.stderr)
        return 1

    page_count = len(entry.get("pages", [])) or 1
    print(f"IMPORTED={entry['id']} PAGES={page_count}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
