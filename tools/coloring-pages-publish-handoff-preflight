#!/usr/bin/env python3
"""Read-only, fail-closed PUBLISH handoff probe for independent v1 activities.

It checks local PNG/manifest identities and declared provider snapshot bindings.
It does NOT create snapshots, verify remote bytes, upload, import, or authorize PUBLISH.
"""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import sys
from datetime import datetime, timezone
from urllib.parse import parse_qs, urlsplit

INDEX_SCHEMA = "rozkalns.coloring-pages.publish-preflight-result.v1"
MANIFEST_SCHEMA = "rozkalns.coloring-pages.drive-staging-manifest.v1"
CAPABILITIES_SCHEMA = "rozkalns.coloring-pages.publish-handoff-capabilities.v1"
BINDINGS_SCHEMA = "rozkalns.coloring-pages.publish-handoff-bindings.v1"
SURFACE = "google-drive.upload_file"
SOURCE_FIELD = "file_uri"
ID = re.compile(r"[0-9]{7}\Z")
SHA = re.compile(r"[0-9a-f]{64}\Z")
PNG_MAGIC = b"\x89PNG\r\n\x1a\n"


class Blocked(ValueError):
    pass


def block(code: str) -> None:
    raise Blocked(code)


def read_json(path: Path) -> object:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        block("invalid-json")


def exact_keys(value: object, keys: set[str], *, code: str) -> dict:
    if not isinstance(value, dict) or set(value) != keys:
        block(code)
    return value


def safe_file(directory: Path, name: object, expected: str) -> Path:
    if name != expected or not isinstance(name, str):
        block("filename-mismatch")
    path = directory / name
    if path.is_symlink() or not path.is_file() or path.resolve().parent != directory.resolve():
        block("local-file-unavailable")
    return path


def prepare_entries(directory: Path) -> list[dict]:
    index = read_json(directory / "preflight-index.json")
    exact_keys(index, {"schema", "activities"}, code="invalid-index")
    if index["schema"] != INDEX_SCHEMA:
        block("invalid-index")
    rows = index["activities"]
    if not isinstance(rows, list) or not 1 <= len(rows) <= 20:
        block("invalid-activity-count")
    seen_ids: set[str] = set()
    expected: list[dict] = []
    for row in rows:
        exact_keys(row, {"id", "png", "manifest", "sha256", "size_bytes"}, code="invalid-index-row")
        identity = row["id"]
        if not isinstance(identity, str) or not ID.fullmatch(identity) or identity in seen_ids:
            block("invalid-or-duplicate-id")
        seen_ids.add(identity)
        if not isinstance(row["sha256"], str) or not SHA.fullmatch(row["sha256"]):
            block("invalid-sha256")
        png_name, manifest_name = identity + ".png", identity + ".json"
        png = safe_file(directory, row["png"], png_name)
        manifest_file = safe_file(directory, row["manifest"], manifest_name)
        png_data = png.read_bytes()
        if not png_data.startswith(PNG_MAGIC):
            block("not-png")
        if not isinstance(row["size_bytes"], int) or isinstance(row["size_bytes"], bool) or row["size_bytes"] < 1:
            block("invalid-size")
        if len(png_data) != row["size_bytes"] or hashlib.sha256(png_data).hexdigest() != row["sha256"]:
            block("png-identity-mismatch")
        manifest = read_json(manifest_file)
        required = {
            "schema", "id", "sha256", "size_bytes", "title", "character",
            "category", "age", "difficulty", "language", "source_kind", "approval_class",
        }
        exact_keys(manifest, required, code="invalid-manifest")
        if (
            manifest["schema"] != MANIFEST_SCHEMA
            or manifest["id"] != identity
            or manifest["sha256"] != row["sha256"]
            or manifest["size_bytes"] != row["size_bytes"]
            or manifest["source_kind"] != "chatgpt-generated-png"
            or manifest["approval_class"] != "explicit-owner-chat-approval"
            or manifest["language"] != "de"
            or manifest["age"] not in ("3-6", "4-8")
            or manifest["difficulty"] not in ("easy", "normal", "detailed")
            or manifest["category"] not in ("tiere", "fahrzeuge", "alphabet", "lernen", "figuren", "jahreszeiten")
            or not isinstance(manifest["title"], str)
            or not manifest["title"].strip()
        ):
            block("manifest-identity-mismatch")
        expected.append({"file": png_name, "sha256": row["sha256"], "size_bytes": row["size_bytes"], "mime_type": "image/png"})
        manifest_bytes = manifest_file.read_bytes()
        expected.append({
            "file": manifest_name, "sha256": hashlib.sha256(manifest_bytes).hexdigest(),
            "size_bytes": len(manifest_bytes), "mime_type": "application/json",
        })
    return expected


def verify_capabilities(capabilities: object) -> None:
    exact_keys(capabilities, {"schema", "upload", "snapshot_materializer"}, code="invalid-capabilities")
    if capabilities["schema"] != CAPABILITIES_SCHEMA:
        block("invalid-capabilities")
    upload = exact_keys(capabilities["upload"], {"surface", "source_field", "accepts"}, code="invalid-capabilities")
    snapshot = exact_keys(
        capabilities["snapshot_materializer"],
        {"available", "source_field", "supports_local_png_and_json"}, code="invalid-capabilities",
    )
    if upload["surface"] != SURFACE or upload["source_field"] != SOURCE_FIELD:
        block("unsupported-upload-surface")
    if not isinstance(upload["accepts"], list) or not {"image/png", "application/json"}.issubset(set(str(x) for x in upload["accepts"])):
        block("unsupported-file-types")
    if (
        snapshot["available"] is not True
        or snapshot["source_field"] != SOURCE_FIELD
        or snapshot["supports_local_png_and_json"] is not True
    ):
        block("snapshot-materializer-unavailable")


def signed_reference_expired_or_invalid(url: str) -> bool:
    """Fail closed for an explicit signed-URL expiry; no provider authenticity proof."""
    try:
        values = parse_qs(urlsplit(url).query, keep_blank_values=True)
        if "se" not in values:
            return False
        if len(values["se"]) != 1:
            return True
        expiry = datetime.fromisoformat(values["se"][0].replace("Z", "+00:00"))
    except ValueError:
        return True
    return expiry.tzinfo is None or expiry <= datetime.now(timezone.utc)


def verify_bindings(bindings: object, expected: list[dict]) -> None:
    exact_keys(bindings, {"schema", "surface", "source_field", "references"}, code="invalid-bindings")
    if bindings["schema"] != BINDINGS_SCHEMA or bindings["surface"] != SURFACE or bindings["source_field"] != SOURCE_FIELD:
        block("unsupported-bindings-surface")
    refs = bindings["references"]
    if not isinstance(refs, list) or len(refs) != len(expected):
        block("missing-or-extra-snapshots")
    ref_by_file: dict[str, dict] = {}
    for item in refs:
        exact_keys(item, {"file", "sha256", "size_bytes", "mime_type", "file_uri"}, code="invalid-binding")
        name = item["file"]
        if not isinstance(name, str) or name in ref_by_file:
            block("duplicate-or-invalid-binding")
        ref_by_file[name] = item
        uri = item["file_uri"]
        # Only a structured, connector-owned exported file reference is an offline candidate.
        # Legacy container_path, source_file_ref and arbitrary URL/path strings are not.
        exact_keys(uri, {"file_id", "download_url", "file_name", "mime_type"}, code="unsupported-reference")
        if (
            not isinstance(uri["file_id"], str) or not uri["file_id"].startswith("sediment://file_")
            or not isinstance(uri["download_url"], str) or not uri["download_url"].startswith("https://")
            or uri["file_name"] != name or uri["mime_type"] != item["mime_type"]
        ):
            block("unsupported-reference")
        if signed_reference_expired_or_invalid(uri["download_url"]):
            block("expired-or-invalid-snapshot-url")
    for entry in expected:
        item = ref_by_file.get(entry["file"])
        if item is None or any(item[k] != entry[k] for k in ("sha256", "size_bytes", "mime_type")):
            block("binding-identity-mismatch")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prepared-dir", required=True, type=Path)
    parser.add_argument("--capabilities", type=Path)
    parser.add_argument("--bindings", type=Path)
    args = parser.parse_args()
    try:
        expected = prepare_entries(args.prepared_dir)
        if args.capabilities is None:
            block("capabilities-not-provided")
        verify_capabilities(read_json(args.capabilities))
        if args.bindings is None:
            block("snapshot-references-not-provided")
        verify_bindings(read_json(args.bindings), expected)
    except (Blocked, OSError) as exc:
        code = str(exc)
        if isinstance(exc, OSError):
            code = "local-read-failure"
        print("HANDOFF_PREFLIGHT=BLOCKED", file=sys.stderr)
        print("REASON=" + code, file=sys.stderr)
        print("DRIVE_MUTATION=NO", file=sys.stderr)
        return 2
    print("HANDOFF_PREFLIGHT=OFFLINE_CANDIDATE_ONLY")
    print("REFERENCES_CHECKED=" + str(len(expected)))
    print("REMOTE_SNAPSHOT_BYTES_VERIFIED=NO")
    print("DRIVE_MUTATION=NO")
    print("PUBLISH_AUTHORIZATION=NOT_GRANTED")
    # A syntactically valid offline inventory is not a publication-ready gate.
    return 3


if __name__ == "__main__":
    raise SystemExit(main())
